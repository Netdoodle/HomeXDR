# Names and IPs agents use to reach this server. They go into the agent TLS certificate;
# the first one is used to build the agent URL. Changing this re-issues the certificate.
HOMEXDR_SERVER_NAMES=homexdr.lan,192.168.1.50

# Override when agents reach the server through a different host/port (NAT, proxy).
HOMEXDR_AGENT_URL=

# ClickHouse password (letters and digits only; it is embedded in a URL).
CLICKHOUSE_PASSWORD=change-me-to-a-long-random-string

# Days of telemetry to keep (0 = no time limit).
HOMEXDR_RETENTION_DAYS=30
# Cap on the event store's size on disk; the oldest days are removed first when it is
# reached. Examples: 1TB, 500GB, 250GiB. Empty = no cap.
HOMEXDR_RETENTION_MAX_SIZE=

# Where ClickHouse keeps its data: empty for a Docker volume, or a path on the disk you
# want events on, e.g. /mnt/disk1/homexdr/clickhouse.
HOMEXDR_CLICKHOUSE_DIR=

# The session cookie is marked Secure on every HTTPS request (also behind a reverse proxy
# that sends X-Forwarded-Proto). Set to true to mark it always, so it never goes over HTTP.
HOMEXDR_SECURE_COOKIES=false
# Reverse proxies in front of the console (IPs/CIDRs). Their X-Forwarded-For is then
# used to count failed logins per visitor instead of per proxy.
HOMEXDR_TRUSTED_PROXIES=

# Comma-separated IPs/CIDRs allowed to send syslog. Empty = private, loopback and
# link-local addresses only. Best: list just your log sources, e.g. your OPNsense LAN
# address. Each new sender becomes a device in the console (at most 25 new ones an hour).
HOMEXDR_SYSLOG_ALLOW=

# NetFlow/IPFIX receiver, off by default. Set to :2055 to turn it on, then follow
# docs/network-visibility.md to point the firewall at it. Flows name the real device behind
# NAT, which traffic detections such as beaconing and upload spikes need.
HOMEXDR_NETFLOW_ADDR=
# Comma-separated IPs/CIDRs allowed to send flows (empty = same as HOMEXDR_SYSLOG_ALLOW).
HOMEXDR_NETFLOW_ALLOW=

# AI analyst API keys. Optional; you can also set them under Settings → AI analyst.
HOMEXDR_ANTHROPIC_API_KEY=
HOMEXDR_OPENAI_API_KEY=
HOMEXDR_GEMINI_API_KEY=
# Only if your local OpenAI-compatible server (Ollama, LM Studio, ...) requires a key.
HOMEXDR_LOCAL_AI_API_KEY=

# Published host ports.
HOMEXDR_CONSOLE_PORT=8080
HOMEXDR_AGENT_PORT=8443
HOMEXDR_SYSLOG_PORT=514
HOMEXDR_NETFLOW_PORT=2055
